TWITTER_API_KEY=your_twitterapi_io_key_here

# Optional Xquik backend for the overlapping Twitter/X read tools.
# TwitterAPI.io stays the default. Set TWITTER_BACKEND=xquik to switch.
# TWITTER_BACKEND=xquik
# XQUIK_API_KEY=your_xquik_key_here
# XQUIK_BASE_URL=https://xquik.com/api/v1

WHISPER_MODEL_PATH=/path/to/models/ggml-base.bin

COBALT_API_URL=https://your-cobalt-instance.example.com
COBALT_API_KEY=your_cobalt_api_key_here
